#ifndef FM_VERSION_H
#define FM_VERSION_H

constexpr int FM_VERSION_MAJOR = @FM_VERSION_MAJOR@;
constexpr int FM_VERSION_MINOR = @FM_VERSION_MINOR@;
constexpr int FM_VERSION_PATCH = @FM_VERSION_PATCH@;

constexpr int FM_VERSION = FM_VERSION_MAJOR * 10000 + FM_VERSION_MINOR * 100 + FM_VERSION_PATCH;

constexpr int v010 = 100;

#endif //FM_VERSION_H
